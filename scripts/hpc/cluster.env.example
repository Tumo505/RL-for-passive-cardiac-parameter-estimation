# Copy to scripts/hpc/cluster.env ON THE CLUSTER, then edit for installed modules.
# Site module names and driver compatibility must be checked on the submission/compute hosts.
HPC_PYTHON=python3
HPC_MODULE_INIT=
TORCH_INDEX_URL=

# Scheduler settings are site-specific and kept in the ignored cluster.env.
HPC_QUEUE=your_gpu_queue
# Example format if your site requires it: software=YOUR_RESOURCE
HPC_SOFTWARE_RESOURCE=
