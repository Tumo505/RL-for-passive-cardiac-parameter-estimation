#!/usr/bin/env bash
#PBS -N cardiac_accuracy
#PBS -l select=1:ncpus=28:mem=240gb:ngpus=4
#PBS -l place=excl
#PBS -l walltime=168:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from project root}"
if [[ -f scripts/hpc/cluster.env ]]; then source scripts/hpc/cluster.env; fi
if [[ -n "${HPC_MODULE_INIT:-}" ]]; then source "$HPC_MODULE_INIT"; fi
mkdir -p logs
# Three reward profiles, four concurrent seeds per profile; validation only.
exec .venv/bin/python -m cardiac_rl.sweep run \
  --suite "${SUITE:-configs/hybrid_sweep.yaml}" \
  --root "${RUN_ROOT:-runs/hybrid_sweep}" --data-dir "${DATA_DIR:-data/hybrid_sweep}"
