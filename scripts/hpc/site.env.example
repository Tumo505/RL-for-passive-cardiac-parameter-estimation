# Copy to site.env and set REMOTE_DIR to your writable project/scratch directory.
# This file is sourced by bash. Do not put credentials in it.
HPC_GATEWAY=your_user@login.example.org
HPC_TARGET=your_user@submission-host
REMOTE_DIR=/replace/with/your/writable/path/SACAM
# Optional: a site module initialisation command/script is sourced on compute nodes.
# Set this to an existing file on the cluster, containing the correct module loads.
HPC_MODULE_INIT=
# Optional CUDA wheel repository matching the cluster's NVIDIA driver.
# Leave empty to use the cluster package index/default PyTorch distribution.
TORCH_INDEX_URL=
HPC_PYTHON=python3
