#!/usr/bin/env bash
#PBS -N cardiac_rl_eval
#PBS -l select=1:ncpus=28:mem=240gb:ngpus=4
#PBS -l place=excl
#PBS -l walltime=168:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project root}"
if [[ -f scripts/hpc/cluster.env ]]; then source scripts/hpc/cluster.env; fi
if [[ -n "${HPC_MODULE_INIT:-}" ]]; then source "$HPC_MODULE_INIT"; fi
mkdir -p logs
exec .venv/bin/python -m cardiac_rl.allocation \
  --config "${CONFIG:-configs/default.yaml}" \
  --data-dir "${DATA_DIR:-data/p100_full}" \
  --output "${RUN_ROOT:-runs/p100_full}" \
  --seeds "${SEEDS:-4}" --seed-start "${SEED_START:-0}" \
  --expected-walltime-hours 0 --evaluate-only
